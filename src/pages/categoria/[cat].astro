---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { generateExcerpt, cleanWpContent } from '../../utils/content';
import postsData from '../../data/posts.json';

const CAT_INFO: Record<string, { name: string; catName: string; desc: string }> = {
  'cuidados':      { name: 'Cuidados',      catName: 'Cuidados',      desc: 'Artículos sobre los cuidados del Labrador Retriever: salud, higiene y bienestar.' },
  'alimentacion':  { name: 'Alimentación',  catName: 'Alimentación',  desc: 'Guías de alimentación para el Labrador Retriever: qué comer, qué evitar y recomendaciones.' },
  'entrenamiento': { name: 'Entrenamiento', catName: 'Entrenamiento', desc: 'Técnicas y consejos para entrenar a tu Labrador Retriever.' },
  'cachorros':     { name: 'Cachorros',     catName: 'Cachorros',     desc: 'Todo sobre los cachorros de Labrador Retriever: crianza, cuidados y primeras semanas.' },
  'resenas':       { name: 'Reseñas',       catName: 'Reseñas',       desc: 'Reseñas de productos para Labrador Retriever: comida, accesorios y más.' },
  'blog':          { name: 'Blog',          catName: 'Blog',          desc: 'Artículos generales sobre el Labrador Retriever.' },
};

export function getStaticPaths() {
  const slugs = ['cuidados', 'alimentacion', 'entrenamiento', 'cachorros', 'resenas', 'blog'];
  return slugs.map(cat => ({ params: { cat }, props: { cat } }));
}

const { cat } = Astro.props as { cat: string };
const info = CAT_INFO[cat];
const posts = (postsData as any[]).filter(p => p.category_name === info.catName);

const siteUrl = 'https://labradores.org';
const canonicalUrl = `${siteUrl}/categoria/${cat}/`;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${info.name} — Labradores.org`,
  "description": info.desc,
  "url": canonicalUrl,
  "inLanguage": "es",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Labradores.org",
    "url": siteUrl
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": info.name, "item": canonicalUrl }
  ]
};
---

<Base
  title={`${info.name} — Labradores.org`}
  description={info.desc}
  canonicalUrl={canonicalUrl}
  schema={[breadcrumbSchema, collectionSchema]}
>
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Inicio</a><span class="sep">›</span>
      <span>{info.name}</span>
    </div>

    <div class="cat-header">
      <div class="cat-pill">{info.name}</div>
      <h1>{info.name}</h1>
      <p>{info.desc} · {posts.length} artículos</p>
    </div>

    <div class="card-grid">
      {posts.map((post: any) => (
        <ArticleCard
          title={post.title}
          slug={post.slug}
          excerpt={post.seoDescription || post.excerpt || generateExcerpt(cleanWpContent(post.body || ''), 115)}
          featuredImage={post.featuredImage}
          date={post.date}
          category={post.category_name}
          categorySlug={cat}
        />
      ))}
    </div>
  </div>
</Base>
