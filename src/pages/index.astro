---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { generateExcerpt, cleanWpContent } from '../utils/content';
import postsData from '../data/posts.json';

const cats = [
  { name: 'Cuidados',       slug: 'cuidados',     emoji: '🩺' },
  { name: 'Alimentación',   slug: 'alimentacion',  emoji: '🥩' },
  { name: 'Entrenamiento',  slug: 'entrenamiento', emoji: '🏃' },
  { name: 'Cachorros',      slug: 'cachorros',     emoji: '🐶' },
  { name: 'Reseñas',        slug: 'resenas',       emoji: '⭐' },
  { name: 'Blog',           slug: 'blog',          emoji: '📝' },
];

// Últimos 6 posts globales
const latestPosts = (postsData as any[]).slice(0, 6);

// Por categoría: 4 más recientes de cada una
function getCatPosts(slug: string, count = 4) {
  const catSlugMap: Record<string,string> = { resenas: 'Reseñas', cuidados: 'Cuidados', alimentacion: 'Alimentación', cachorros: 'Cachorros', entrenamiento: 'Entrenamiento', blog: 'Blog' };
  const catName = catSlugMap[slug] || slug;
  return (postsData as any[]).filter(p => p.category_name === catName).slice(0, count);
}

const siteUrl = 'https://labradores.org';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Labradores.org",
  "url": siteUrl,
  "inLanguage": "es",
  "description": "La guía más completa en español sobre el Labrador Retriever: cuidados, alimentación, entrenamiento, cachorros, salud y reseñas de productos.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/?s={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Labradores.org",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/images/labradores-favicon.png`
  },
  "sameAs": [],
  "description": "Sitio informativo sobre el Labrador Retriever en español."
};
---

<Base
  title="Labradores.org — Todo sobre el Labrador Retriever"
  description="Tu guía completa sobre el Labrador Retriever: cuidados, alimentación, entrenamiento, cachorros, salud y reseñas de productos."
  schema={[websiteSchema, organizationSchema]}
>
  <section class="hero">
    <div class="container">
      <h1>Todo sobre el Labrador Retriever</h1>
      <p>La guía más completa en español sobre la raza más popular: cuidados, salud, alimentación y mucho más.</p>
      <div class="hero-cats">
        {cats.map(c => (
          <a href={`/categoria/${c.slug}/`} class="hero-cat-link">{c.emoji} {c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <h2 class="section-title">Últimos artículos <a href="/blog">Ver todos →</a></h2>
    <div class="card-grid">
      {latestPosts.map((post: any) => (
        <ArticleCard
          title={post.title}
          slug={post.slug}
          excerpt={post.seoDescription || post.excerpt || generateExcerpt(cleanWpContent(post.body || ''), 120)}
          featuredImage={post.featuredImage}
          date={post.date}
          category={post.category_name}
          categorySlug={post.category_slug}
        />
      ))}
    </div>

    {cats.filter(c => c.slug !== 'blog').map(cat => {
      const catPosts = getCatPosts(cat.slug);
      if (!catPosts.length) return null;
      return (
        <div>
          <h2 class="section-title">
            {cat.emoji} {cat.name}
            <a href={`/categoria/${cat.slug}/`}>Ver todos →</a>
          </h2>
          <div class="card-grid">
            {catPosts.map((post: any) => (
              <ArticleCard
                title={post.title}
                slug={post.slug}
                excerpt={post.seoDescription || post.excerpt || generateExcerpt(cleanWpContent(post.body || ''), 110)}
                featuredImage={post.featuredImage}
                date={post.date}
                category={post.category_name}
                categorySlug={post.category_slug}
              />
            ))}
          </div>
        </div>
      );
    })}
  </div>
</Base>
