---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  schema?: object | object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = 'Todo sobre el Labrador Retriever: cuidados, alimentación, entrenamiento, cachorros y reseñas de productos.',
  ogImage,
  canonicalUrl,
  schema,
  noindex = false,
  ogType = 'website',
  prevUrl,
  nextUrl,
} = Astro.props;

const siteUrl = 'https://labradores.org';
const fullCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  {prevUrl && <link rel="prev" href={prevUrl} />}
  {nextUrl && <link rel="next" href={nextUrl} />}

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:site_name" content="Labradores.org" />
  <meta property="og:locale" content="es_ES" />
  {ogImage && <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : siteUrl + ogImage} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : siteUrl + ogImage} />}

  <link rel="icon" type="image/png" href="/images/labradores-favicon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1887931946230317" crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="site-logo">
        <span class="logo-paw">🐾</span>
        <span>Labradores<strong>.org</strong></span>
      </a>

      <button class="nav-toggle" aria-label="Abrir menú" id="navToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>

      <nav class="main-nav" id="mainNav">
        <a href="/">Inicio</a>
        <a href="/categoria/cuidados/">Cuidados</a>
        <a href="/categoria/alimentacion/">Alimentación</a>
        <a href="/categoria/entrenamiento/">Entrenamiento</a>
        <a href="/categoria/cachorros/">Cachorros</a>
        <a href="/categoria/resenas/">Reseñas</a>
        <a href="/blog/">Blog</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-brand">🐾 <strong>Labradores.org</strong></div>
          <p class="footer-desc">Tu guía de referencia sobre el Labrador Retriever en español: cuidados, salud, alimentación y más.</p>
        </div>
        <div class="footer-col">
          <h4>Categorías</h4>
          <a href="/categoria/cuidados/">Cuidados</a>
          <a href="/categoria/alimentacion/">Alimentación</a>
          <a href="/categoria/entrenamiento/">Entrenamiento</a>
          <a href="/categoria/cachorros/">Cachorros</a>
          <a href="/categoria/resenas/">Reseñas</a>
          <a href="/blog/">Blog general</a>
        </div>
        <div class="footer-col">
          <h4>Páginas</h4>
          <a href="/labrador-retriever/">Labrador Retriever</a>
          <a href="/sobre-nosotros/">Sobre nosotros</a>
          <a href="/politica-de-privacidad/">Política de privacidad</a>
          <a href="/contacto/">Contacto</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Labradores.org — Información sobre el Labrador Retriever.</p>
        <p class="footer-affiliate-note">Labradores.org es participante en el Programa de Afiliados de Amazon EU, un programa de publicidad para afiliados diseñado para ofrecer a sitios web un medio de obtener comisiones por publicidad mediante la creación de enlaces a amazon.es. Como Asociado de Amazon, obtenemos comisión por las compras que califican, sin coste adicional para el comprador.</p>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('navToggle')?.addEventListener('click', () => {
      document.getElementById('mainNav')?.classList.toggle('active');
    });
  </script>
</body>
</html>
